# ========== Phase 6 .env — 所有 hardcoded 配置都从 env 读 ==========
# 复制为 .env 后填实际值。dev 缺省:localhost/root/root/travel_rag
# 必填项(无 dev 缺省,必须 .env 写):API_KEY, AUTH_JWT_SECRET

# ---------- LLM ----------
# 默认 base_url = https://api.minimaxi.com/v1(MiniMax 开放平台)
BASE_URL=https://api.minimaxi.com/v1
# 必填:无缺省,dev 需 .env 写入
API_KEY=
# 对话模型:默认 MiniMax-Text-01
MODEL=MiniMax-Text-01
# 采样温度:0-2 浮点,默认 0.1
TEMPERATURE=0.1

# ---------- MySQL ----------
# CorpAI 项目专用库(CorpAI@localhost,账户 admin / <your-password>)
MYSQL_HOST=localhost
MYSQL_USER=admin
MYSQL_PASSWORD=<your-password>
MYSQL_DATABASE=CorpAI
# 连接池(Phase 6:env override)
MYSQL_POOL_NAME=corp_ai_pool
MYSQL_POOL_SIZE=5

# ---------- Milvus ----------
# 默认 localhost — docker compose -f corpai-milvus.yml up -d 启的 standalone
# 远程 dev 改成你的 LAN IP(如 192.168.x.x);不要硬编码到代码,全 .env 注入
MILVUS_HOST=localhost
MILVUS_PORT=19530
# Attu UI 端口(避开 hr_assistant insurance_mcp :8010)
ATTU_URL=http://localhost:8012
# faq plugin 用的 collection
FAQ_COLLECTION=faq_docs

# ---------- Embedding(独立于 LLM,缺省回退)----------
# 缺省时与 LLM 同源
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embo-01
# type 提示: db=入库时用, query=检索时用(影响语义检索质量)
EMBEDDING_TYPE_INSERT=db
EMBEDDING_TYPE_QUERY=query
# 向量维度(MiniMax embo-01 = 1536)
EMBEDDING_DIM=1536

# ---------- Phase 3 RBAC ----------
# Admin UI JWT 签名密钥(必须设置,否则 admin 端点启动失败 — fail-closed)
# 至少 32 字节随机串,生产环境用 secrets.token_urlsafe(48) 生成
AUTH_JWT_SECRET=change-me-to-a-random-string-min-32-chars

# ---------- Phase 1 devops_copilot 真 SDK 接入 ----------
# query_incident 接 Jira REST API v3
# Token:https://id.atlassian.com/manage-profile/security/api-tokens (Personal Access Token)
JIRA_URL=
JIRA_TOKEN=
JIRA_PROJECT=INC
# Atlassian API Token 必须 Basic auth = base64(email:token),不写 JIRA_EMAIL → not_configured
JIRA_EMAIL=

# query_oncall 接 PagerDuty
# API key:Settings → API Access → REST API keys
PAGERDUTY_API_KEY=
# 各 team 的 schedule ID,env key = PAGERDUTY_SCHEDULE_ID_<TEAM_UPPER>
PAGERDUTY_SCHEDULE_ID_PLATFORM=
PAGERDUTY_SCHEDULE_ID_DATA=
PAGERDUTY_SCHEDULE_ID_SECURITY=

# query_alert 接 Prometheus Alertmanager v2
# dev 可指 https://alertmanager.dev.prometheus.io 看演示告警
PROMETHEUS_URL=

# get_pod_logs 接 kubernetes-python
# dev 默认 DRY_RUN=true(返 stub 日志,无需 K8s);生产设 false 走真实 API
K8S_DRY_RUN=true
# 集群外运行时:设 KUBECONFIG=/path/to/kubeconfig
# 集群内运行时:留空,自动 load_incluster_config
KUBECONFIG=

# ---------- 跨插件 bridge 目标 URL(供 HR/SRE 互相调用)----------
FAQ_URL=http://localhost:8030
SRE_INCIDENT_URL=http://localhost:8020
SRE_K8S_URL=http://localhost:8021

# ---------- Feishu 飞书(SRE.g 审批卡片推送)----------
# 获取路径:https://open.feishu.cn → 创建企业自建应用 → 凭证页 → App ID / App Secret
# FEISHU_APP_ID 长这样:cli_xxxxxxxxxxxxx
FEISHU_APP_ID=
# FEISHU_APP_SECRET 32+ 字符
FEISHU_APP_SECRET=
# 事件订阅页面的 Verification Token(用于验证 callback URL 归属)
FEISHU_VERIFY_TOKEN=
# 加密 key(可选 — 不填 = 不强制签名校验,生产建议填)
FEISHU_ENCRYPT_KEY=
# 审批卡片推给谁(默认测试群 chat_id;真上线改成 on-call 组的 chat_id)
FEISHU_TEST_RECEIVE_ID=
# 事件订阅 callback URL(填在飞书后台「事件与回调 → 回调配置」)
# 生产用公网域名;本地调试用 ngrok 暴露(ngrok http 8080 → 给你 https://xxx.ngrok.io)
# FEISHU_PUBLIC_URL=https://abc123.ngrok.io

# ---------- ngrok(本地暴露 8080 给飞书用)----------
# 注册:https://dashboard.ngrok.com/signup → 拿 token:https://dashboard.ngrok.com/get-started/your-authtoken
# scripts/run_all.py 启 ngrok 前会自动跑 `ngrok config add-authtoken <token>` 配好
NGROK_AUTHTOKEN=
# 固定 subdomain(可选 — ngrok paid 才生效;free 版留空 = 每次启动 URL 变)
# NGROK_DOMAIN=corpai.ngrok-free.app

# ---------- SRE Action Executor(异步执行 AI 生成的修复方案)----------
# dev 默认 true,只返 dry_run 不真调 K8s/Jira;生产设 false 走真 SDK
SRE_DRY_RUN=true
# Redis Stream 用,本地默认 redis://localhost:6379/0
REDIS_URL=redis://localhost:16379/0
# v3.2:Windows 默认 6379 被端口排除占用,起 corpai-redis.yml 时改 16379 映射到容器 6379
# 改这里要同步改 corpai-redis.yml 的 ports mapping
