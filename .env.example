# ========== Phase 6 .env — 所有 hardcoded 配置都从 env 读 ==========
# 复制为 .env 后填实际值。dev 缺省:localhost/root/root/travel_rag
# 必填项(无 dev 缺省,必须 .env 写):API_KEY, AUTH_JWT_SECRET

# ---------- LLM ----------
# 默认 base_url = https://api.minimaxi.com/v1(MiniMax 开放平台)
BASE_URL=https://api.minimaxi.com/v1
# 必填:无缺省,dev 需 .env 写入
API_KEY=
# 对话模型:默认 MiniMax-Text-01
MODEL=MiniMax-Text-01
# 采样温度:0-2 浮点,默认 0.1
TEMPERATURE=0.1

# ---------- MySQL ----------
# CorpAI 项目专用库(CorpAI@localhost,账户 admin / <your-password>)
MYSQL_HOST=localhost
MYSQL_USER=admin
MYSQL_PASSWORD=<your-password>
MYSQL_DATABASE=CorpAI
# 连接池(Phase 6:env override)
MYSQL_POOL_NAME=corp_ai_pool
MYSQL_POOL_SIZE=5

# ---------- 天气数据源 ----------
# WEATHER_SOURCE 必须是 database 或 api,启动时校验
WEATHER_SOURCE=database

# ---------- 和风天气 API(WEATHER_SOURCE=api 时需要)----------
WEATHER_API_KEY=
WEATHER_BASE_URL=
WEATHER_API_HOST=
WEATHER_TIMEZONE=Asia/Shanghai
# 定时更新调度时间
WEATHER_SCHEDULE_TIME=01:00

# ---------- Milvus ----------
MILVUS_HOST=192.168.88.100
MILVUS_PORT=19530
# Phase 5:faq plugin 用的 collection
FAQ_COLLECTION=faq_docs
# Phase 7:删除 TOUR_GROUP_COLLECTION(旅行 plugin 已删)

# ---------- Embedding(独立于 LLM,缺省回退)----------
# 缺省时与 LLM 同源
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embo-01
# type 提示: db=入库时用, query=检索时用(影响语义检索质量)
EMBEDDING_TYPE_INSERT=db
EMBEDDING_TYPE_QUERY=query
# 向量维度(MiniMax embo-01 = 1536)
EMBEDDING_DIM=1536

# ---------- Phase 3 RBAC ----------
# Admin UI JWT 签名密钥(必须设置,否则 admin 端点启动失败 — fail-closed)
# 至少 32 字节随机串,生产环境用 secrets.token_urlsafe(48) 生成
AUTH_JWT_SECRET=change-me-to-a-random-string-min-32-chars
