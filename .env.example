# ========== 大模型配置（MiniMax - OpenAI 兼容协议）==========
# 默认 base_url = https://api.minimaxi.com/v1（MiniMax 开放平台）
BASE_URL=https://api.minimaxi.com/v1
API_KEY=
# 对话模型：默认 MiniMax-Text-01，可改为 abab-6.5s-chat / abab-7-chat 等
MODEL=MiniMax-Text-01

# ========== Embedding 配置（旅游团 RAG 在用）==========
# 独立于 LLM 配置；缺省时回退到上面 LLM 的 BASE_URL/API_KEY
# MiniMax 的 /v1/embeddings 不是 OpenAI 兼容:入参 texts + type,返回 vectors
EMBEDDING_BASE_URL=https://api.minimax.chat/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embo-01
# type 提示: db=入库时用, query=检索时用(影响语义检索质量)
EMBEDDING_TYPE_INSERT=db
EMBEDDING_TYPE_QUERY=query

# ========== 和风天气 API 配置 ==========
WEATHER_API_KEY=
WEATHER_BASE_URL=
WEATHER_API_HOST=
WEATHER_TIMEZONE=